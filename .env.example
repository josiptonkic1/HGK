# Kopirajte u .env i promijenite vrijednosti.
PORT=3000
# 127.0.0.1 = samo ovo računalo (zadano). Na serveru bez reverse proxyja: HOST=0.0.0.0
HOST=127.0.0.1
DB_FILE=./data/zlatna-kuna.db

# Tajni ključ za potpisivanje kolačića prijave (barem 32 nasumična znaka).
SESSION_SECRET=promijenite-me-na-dugi-nasumicni-niz

# Početni korisnici - kreiraju se pri pokretanju ako u bazi još nema korisnika te uloge.
# Ostale korisnike dodajete u aplikaciji (Postavke i korisnici).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promijenite-me
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=promijenite-me

# U produkciji (HTTPS): COOKIE_SECURE=true, a iza reverse proxyja TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=
